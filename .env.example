# Copy to .env and adjust. Sourced by scripts/start-openobserve.sh.
# These index settings must be in effect BEFORE ingesting data.

# --- OpenObserve auth (must match datagen + run-benchmark.py) ---
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123

# --- Two isolated OpenObserve instances ---
# These are the only process-level differences between the O2 backends. The
# start script fixes ZO_FILE_FORMAT to parquet or vortex from its positional
# argument, so a stale .env cannot silently mix formats in one data directory.
O2_PARQUET_DATA_DIR=./openobserve-parquet-data
O2_PARQUET_HTTP_PORT=5080
O2_PARQUET_GRPC_PORT=5081

O2_VORTEX_DATA_DIR=./openobserve-vortex-data
O2_VORTEX_HTTP_PORT=5090
O2_VORTEX_GRPC_PORT=5091

# Rotate open WAL files after 60s (default 600s) so the ingest tail reaches
# parquet + file_list quickly instead of idling in the WAL for up to 10 min.
ZO_MAX_FILE_RETENTION_TIME=60
# O2 v0.92.2 defaults to 120 minutes. For this disk-bound benchmark, compacted
# source files become eligible for physical deletion after 10 minutes.
ZO_COMPACT_DELETE_FILES_DELAY_MINUTES=10

# --- Indexing (same settings for O2-Parquet and O2-Vortex) ---
ZO_ENABLE_INVERTED_INDEX=true
# Full-text indexed field: message. The token queries q2/q3/q5/q6/q10 hit the
# Tantivy FTS index, mirroring ClickHouse's text() index.
ZO_FEATURE_FULLTEXT_EXTRA_FIELDS=message
# Secondary-indexed columns: the high-cardinality fields used by equality
# queries — trace_id (q0/q4), span_id (q1), kubernetes_pod_name (q7).
# kubernetes_container_name is deliberately NOT indexed on either engine (it is
# low-cardinality — 8 values — so an index prunes nothing, and indexing it on
# only one side would be unfair).
ZO_FEATURE_INDEX_EXTRA_FIELDS=trace_id,span_id,kubernetes_pod_name
# O2's bloom engine is enabled by default in v0.92.2, but its field list is
# empty by default. Select trace_id explicitly so ClickHouse and both O2 formats
# have a bloom-pruning layer for the primary ID lookup.
ZO_BLOOM_FILTER_ENABLED=true
ZO_FEATURE_BLOOM_FILTER_EXTRA_FIELDS=trace_id
ZO_BLOOM_FILTER_FPP=0.01
ZO_BLOOM_FILTER_PARQUET_ENABLED=false
